---
import Dashboard from '../../layouts/Dashboard.astro';
import DataControlCenter from '../../components/DataControlCenter.jsx';
import SyncPanel from '../../components/SyncPanel.jsx';
import AnalyticsDashboard from '../../components/AnalyticsDashboard.jsx';
---

<Dashboard>
  <h1 class="text-2xl font-bold text-slate-900 mb-2">Central de Curadoria de Dados — Horizon Legacy</h1>
  <p class="text-slate-600 mb-6">
    Bem-vindo ao Portal de Administração (Horizon Legacy). Consulte os indicadores abaixo ou selecione uma entidade no menu lateral para visualizar e corrigir seus registros.
  </p>
  
  <AnalyticsDashboard client:load endpoint="/analytics" />
  <DataControlCenter client:load />
  <SyncPanel client:load project="horizon" allowUpload={true} />
</Dashboard>
