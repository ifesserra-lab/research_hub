---
import HorizonDashboard from '../../layouts/HorizonDashboard.astro';
import EntityPage from '../../components/EntityPage.jsx';
---

<HorizonDashboard>
  <EntityPage
    client:load
    entity="organizations"
    apiPrefix="/horizon-v2"
    basePath="/horizon"
    columns={['id', 'name', 'short_name', 'campus']}
    fields={[
      { name: 'id', label: 'ID', type: 'number' },
      { name: 'name', label: 'Nome', required: true },
      { name: 'description', label: 'Descrição' },
      { name: 'short_name', label: 'Sigla' },
      { name: 'campus', label: 'Campus (Vínculos)', type: 'json_readonly' }
    ]}
  />
</HorizonDashboard>
