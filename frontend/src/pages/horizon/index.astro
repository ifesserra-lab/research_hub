---
import HorizonDashboard from '../../layouts/HorizonDashboard.astro';
import DataControlCenter from '../../components/DataControlCenter.jsx';
import SyncPanel from '../../components/SyncPanel.jsx';
---

<HorizonDashboard>
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Central de Curadoria de Dados — Horizon</h1>
  <p class="text-slate-600">Bem-vindo ao espaço de curadoria do novo pacote canônico Horizon. Selecione uma entidade no menu lateral para visualizar e corrigir seus registros.</p>

  <DataControlCenter client:load apiPrefix="/horizon-v2" />
  <SyncPanel client:load project="horizon_v2" allowUpload={true} />
</HorizonDashboard>
