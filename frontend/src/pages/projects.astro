---
// SEP-033 / SEP-035 (FR-001..FR-002): página principal pós-login com seleção
// entre Horizon, SRC e Egressos. Nenhuma base é carregada antes da escolha.
import ProjectSelector from '../components/ProjectSelector.jsx';

const PROJECTS = [
  {
    id: 'horizon',
    title: 'Horizon',
    description: 'Tabelas canônicas do DataLake (15 abas de curadoria)',
    href: '/dashboard',
  },
  {
    id: 'src',
    title: 'SRC',
    description: 'JSON consolidado do SRC/Ifes (ações de extensão e ensino)',
    href: '/src',
  },
  {
    id: 'egressos',
    title: 'Egressos',
    description: 'Painel de carreira e renda dos egressos do IFES Campus Serra (21 tabelas JSON da pasta dados/)',
    href: '/egressos',
  },
];
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seleção de Projeto - ResearchHub</title>
  </head>
  <body class="m-0 font-sans antialiased bg-slate-50 text-slate-900 min-h-screen flex flex-col items-center justify-center gap-8">
    <script>
      import { invoke } from '@tauri-apps/api/core';
      (async () => {
        try {
          const { authenticated } = await invoke<{ authenticated: boolean }>('session_status');
          if (!authenticated) {
            localStorage.removeItem('token');
            window.location.replace('/login');
          }
        } catch {}
      })();

      let unsaved = false;
      window.addEventListener('src:dirty', (ev: Event) => {
        unsaved = !!(ev as CustomEvent).detail;
      });
      window.addEventListener('egressos:dirty', (ev: Event) => {
        unsaved = !!(ev as CustomEvent).detail;
      });
      document.addEventListener(
        'click',
        (ev) => {
          if (!unsaved) return;
          const card = (ev.target as HTMLElement)?.closest('button');
          if (!card) return;
          if (
            !window.confirm(
              'Há alterações não salvas neste projeto. Trocar de projeto agora pode perder o trabalho em andamento. Continuar?'
            )
          ) {
            ev.stopPropagation();
            ev.preventDefault();
          }
        },
        true
      );
    </script>
    <header class="text-center px-4">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">
        Em qual projeto você quer trabalhar?
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Os dados de cada projeto são mantidos separados.
      </p>
    </header>
    <ProjectSelector client:load projects={PROJECTS} />
  </body>
</html>
